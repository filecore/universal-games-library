# Public host (Traefik will route this to the app)
PUBLIC_HOST=games.togneri.net

# Postgres
POSTGRES_USER=games
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=games

# IGDB (Twitch dev portal: https://dev.twitch.tv/console)
IGDB_CLIENT_ID=CHANGE_ME
IGDB_CLIENT_SECRET=CHANGE_ME

# Steam Web API (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=CHANGE_ME
STEAM_ID=CHANGE_ME

# BoardGameGeek (your username)
BGG_USERNAME=CHANGE_ME

# Optional: protect POST /api/ingest/* endpoints with a shared secret.
# Leave blank for open writes (site is otherwise public).
# If set, all ingest requests must include header X-Ingest-Token: <value>.
INGEST_TOKEN=

# Timezone
TZ=Europe/Helsinki
